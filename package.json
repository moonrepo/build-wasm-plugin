{
  "name": "@moonrepo/build-wasm-plugin",
  "version": "0.5.0",
  "description": "A GitHub action to build, optimize, and publish WASM plugins.",
  "main": "dist/index.js",
  "scripts": {
    "build": "ncc build ./index.ts",
    "check": "pnpm run test && pnpm run typecheck",
    "deps": "pnpm update --latest --interactive",
    "test": "echo 'Not yet'",
    "test:input": "ts-node ./index.ts",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/moonrepo/build-wasm-plugin"
  },
  "author": "Miles Johnson",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^2.0.3",
    "@actions/exec": "^2.0.0",
    "@actions/tool-cache": "^3.0.1",
    "@ltd/j-toml": "^1.38.0",
    "changelog-parser": "^3.0.1",
    "semver": "^7.8.0"
  },
  "devDependencies": {
    "@types/changelog-parser": "^2.8.4",
    "@types/node": "^24.12.3",
    "@types/semver": "^7.7.1",
    "@vercel/ncc": "^0.38.4",
    "prettier": "^3.8.3",
    "prettier-config-moon": "^1.2.2",
    "tsconfig-moon": "^1.3.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
